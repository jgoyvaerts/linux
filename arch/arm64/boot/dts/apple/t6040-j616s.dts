/*
 * Apple MacBook Pro 16-inch (Mac16,7, J616s, T6040) for the M4 loader (rev 11).
 *
 * Filled in at boot by the loader from the ADT and its own layout (src/standalone/fixups.c):
	 * /memory: reg (single multi-range node), /memreserve map
	 * /chosen: bootargs, linux,initrd-*, rng-seed, m4,* records, lab,* descriptor; framebuffer node reg/format/size/stride/status
	 * /reserved-memory: reg of direct-smp-*, direct-desktop-*, aop-*; dcp-map pool (name, reg, compatible, iommu-addresses); memory-region lists
	 * dcp/display-subsystem/mailbox@402e08000/iommu@402340000/iommu@402300000: status okay once the display capture is accepted
	 * /cpus/cpu@*: cpu-release-addr from the SMP peer records
	 * bluetooth@0,1: local-bd-address, brcm,taurus-bf-cal-blob; wifi@0,0: brcm,cal-blob, apple,antenna-sku (ADT)
	 * headphone-codec-probe: status, lab,admission-result, lab,current-adt-validated (ADT contract)
	 * keyboard: hid-country-code (ADT)
 *
 * Declared differences from the rev 10 final tree: atc2_usb_aon is apple,always-on; the memory ranges are one
 * multi-range node; no m4,* diagnostic records.
 */

/dts-v1/;

/include/ "t6040.dtsi"
/include/ "t6040-j616s-gpu.dtsi"
/include/ "t6040-cpufreq.dtsi"
/include/ "t6040-pmc-mcc.dtsi"

/ {
	model = "Apple MacBook Pro (16-inch, M4 Pro, 2024)";
	compatible = "apple,j616s", "apple,t6040", "apple,arm-platform";

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		aop-oslog {
			no-map;
		};

		aop-etext {
			no-map;
		};

		direct-desktop-host1 {
			no-map;
		};

		direct-desktop-host0 {
			no-map;
		};

		direct-desktop-capture {
			no-map;
		};

		direct-smp-peers {
			no-map;
		};

		direct-smp-stacks {
			no-map;
		};

		direct-smp-records {
			no-map;
		};

		direct-smp-code {
			no-map;
		};

		direct-smp-vector {
			no-map;
		};

		dcp-map-pool0 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool1 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool2 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool3 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool4 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool5 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool6 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool7 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool8 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool9 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool10 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool11 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool12 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool13 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool14 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};

		dcp-map-pool15 {
			compatible = "apple,asc-mem";
			no-map;
			status = "disabled";
		};
	};

	headphone-codec-probe {
		compatible = "lab,j616s-headphone-control-v1";
		reg = <4 0x29018000 0 0x4000 5 0x81e4000 0 0x4000>;
		clock-frequency = <0x16e3600>;
		codec-address = <0x4b>;
		status = "disabled";
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			color = <0>;
			function = "kbd_backlight";
			default-state = "keep";
			label = "apple::kbd_backlight";
			max-brightness = <0xff>;
			pwms = <&kbd_pwm 0 0x9c40>;
		};
	};

	clk_kbd_pwm: clock-kbd-pwm {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0x16e3600>;
	};

	chosen {
		ranges;
		#size-cells = <2>;
		#address-cells = <2>;

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			status = "disabled";
		};
	};

	memory@0 {
		reg = <0 0 0 0>;
		device_type = "memory";
	};
};

&mtp_hid {
	/* SMC key gp1c powers the trackpad analog front end. */
	apple,afe-smc = <&smc>;
};

/*
 * CPU die temperature: SMC key TCMz (CPU die max) as thermal sensor 0 (method from Kb2uka/Omarchy-M4-Native's
 * J713 overlays). It is the only temperature child, so a missing key gives no zone instead of another sensor.
 * The PMP's fast die-temperature limit regulates (TCMz settles near 111 C); this zone is the backstop above it:
 * passive at 113 C, critical (orderly shutdown) at 118 C, 1 s polling as the SMC refreshes TCMz about once a
 * second. The cpufreq cooling device sits on a cluster's policy CPU, so each map lists every CPU of its cluster.
 */
&smc {
	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
		#thermal-sensor-cells = <1>;

		temperature-TCMz {
			apple,key-id = "TCMz";
			label = "CPU Die Max";
		};
	};
};

/ {
	thermal-zones {
		cpu-die-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <1000>;
			thermal-sensors = <&smc_hwmon 0>;

			trips {
				cpu_die_passive: cpu-die-passive {
					temperature = <113000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu-die-critical {
					temperature = <118000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-e {
					trip = <&cpu_die_passive>;
					cooling-device = <&cpu_e0 0xffffffff 0xffffffff>, <&cpu_e1 0xffffffff 0xffffffff>,
							 <&cpu_e2 0xffffffff 0xffffffff>, <&cpu_e3 0xffffffff 0xffffffff>;
				};

				map-p0 {
					trip = <&cpu_die_passive>;
					cooling-device = <&cpu_p00 0xffffffff 0xffffffff>, <&cpu_p01 0xffffffff 0xffffffff>,
							 <&cpu_p02 0xffffffff 0xffffffff>, <&cpu_p03 0xffffffff 0xffffffff>,
							 <&cpu_p04 0xffffffff 0xffffffff>;
				};

				map-p1 {
					trip = <&cpu_die_passive>;
					cooling-device = <&cpu_p10 0xffffffff 0xffffffff>, <&cpu_p11 0xffffffff 0xffffffff>,
							 <&cpu_p12 0xffffffff 0xffffffff>, <&cpu_p13 0xffffffff 0xffffffff>,
							 <&cpu_p14 0xffffffff 0xffffffff>;
				};
			};
		};
	};
};

/*
 * Internal speakers: the six SN012776 amps, held in hardware shutdown until a sound card enables them. ADT master
 * node /arm-io/i2c1/audio-speaker@38: shutdown (SDZ) on AP pin 54 for all six, low = shutdown; one IRQ line on AP
 * pin 55, level low; sense slots from speaker-config (speaker i at RX bytes 4i and 4i + 2, order LW1 RW1 LW2 RW2
 * LT RT). Names as Asahi's J314/J316, which speakersafetyd's profile uses.
 * The shutdown line is one fixed regulator, the SDZ supply of all six, not per-amp shutdown-gpios: with
 * GPIO_SHARED six references become a vote, and one amp driving the line low would not shut the other five down.
 */
/ {
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl 54 0>;
		enable-active-high;
	};
};

&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <8>;
		ti,vmon-slot-no = <10>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <16>;
		ti,vmon-slot-no = <18>;
	};
};

&i2c3 {
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <4>;
		ti,vmon-slot-no = <6>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <12>;
		ti,vmon-slot-no = <14>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		SDZ-supply = <&speaker_sdz>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl 55 8>;
		ti,imon-slot-no = <20>;
		ti,vmon-slot-no = <22>;
	};
};
