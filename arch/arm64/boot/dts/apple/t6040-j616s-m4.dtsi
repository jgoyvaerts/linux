/*
 * The AOP and ISP DARTs' address filters (DAPF), programmed from the J616s
 * ADT's filter data: <start end r0 r4 r20>. The second register range is
 * the filter block.
 */
&aop_dart {
	reg = <0x5 0x10f00000 0x0 0xc000>, <0x5 0x10f10000 0x0 0x4000>;
	apple,dapf-entries = /bits/ 64 <
		0x5081e4020 0x5081e4043 0x31 0x0 0x1
		0x5081e4880 0x5081e4c50 0x31 0x0 0x1
		0x508240004 0x508240373 0x31 0x0 0x1
		0x508304000 0x50830416b 0x31 0x0 0x1
		0x508320280 0x50832048b 0x31 0x0 0x1
		0x508370000 0x5083709a3 0x31 0x0 0x1
		0x508900014 0x508900017 0x31 0x0 0x1
		0x50c618110 0x50c61881f 0x31 0x0 0x1
		0x50c634000 0x50c634003 0x31 0x0 0x1
		0x50de00000 0x50defffff 0x31 0x0 0x1
		0x508018000 0x50801bfff 0x31 0x0 0x1
		0x50801c000 0x50801ffff 0x31 0x0 0x1
	>;
};

&isp_dart0 {
	reg = <0x5 0x828c0000 0x0 0xc000>, <0x5 0x828d0000 0x0 0x4000>;
	apple,dapf-entries = /bits/ 64 <
		0x502284000 0x50228402b 0x31 0x0 0x1
		0x502880000 0x502887fff 0x31 0x0 0x1
		0x500e3c000 0x500e3c003 0x31 0x0 0x1
		0x51062c000 0x510648003 0x31 0x0 0x1
		0x485660000 0x485660003 0x31 0x0 0x1
		0x220004000 0x2201d62fc 0x31 0x0 0x1
		0x222004000 0x2221d62fc 0x31 0x0 0x1
		0x224004000 0x2241d62fc 0x31 0x0 0x1
		0x226004000 0x2261d62fc 0x31 0x0 0x1
		0x504824000 0x504824004 0x31 0x0 0x1
		0x5003c0000 0x5003e4000 0x31 0x0 0x1
	>;
};

/* SMC key gp1c powers the trackpad analog front end. */
&mtp_hid {
	apple,afe-smc = <&smc>;
};

/* The surface layout the imported M4 display driver reads */
&dcp {
	apple,iomfb-surface-order = <0 1>;
	apple,iomfb-primary-surface = <0>;
	apple,iomfb-max-layers = <2>;
};

/* 4. Kept as the booted tree has them */

&aic {
	#address-cells = <0>;
};

&aop {
	#address-cells = <2>;
	#size-cells = <2>;
};

&dcp {
	#address-cells = <2>;
	#size-cells = <2>;
	/* The 26.6.2 boot firmware; the display handoff checks the ADT's build first. */
	apple,firmware-version = <0x1a 6 2>;
	apple,firmware-compat = <0x1a 6 2>;
};

/*
 * The GPU driver identifies its firmware build by this, on its own node. The loader does not
 * write it yet (its next revision writes os_firmware here, as m1n1 does): 26.6.2 for now.
 */
&gpu {
	apple,firmware-version = <0x1a 6 2>;
};

/ {
	aliases {
		disp0_piodma = &disp0_piodma;
	};
};

/*
 * The PCIe node's phandles as the booted tree has them: the loader's
 * Bluetooth admission runs on that node (rev 14 and later read only its
 * config window and bus-range, so the extra port and PHY windows are
 * fine). These are the phandles it carries or names (the AIC in msi-ranges
 * and interrupt-parent, the DART, the CLKREQ pin, the SMC GPIO and AP pin
 * controller, the port and itself).
 */
&aic {
	phandle = <0x1>;
};

&pinctrl {
	phandle = <0x49>;
};

&wifi_clkreq {
	phandle = <0x78>;
};

&pcie_dart {
	phandle = <0x79>;
};

&pcie0 {
	phandle = <0x7a>;
};

&port00 {
	phandle = <0x7b>;
};

&smc_gpio {
	phandle = <0x7c>;
};
